{
    "name": "componenta/error-handler",
    "description": "HTTP and CLI error handling for Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "componenta/http": "^1.0",
        "ext-mbstring": "*",
        "nyholm/psr7-server": "^1.1",
        "php": "^8.4",
        "psr/clock": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "symfony/console": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Error\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Error\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^12.0",
        "pestphp/pest": "^4.0",
        "phpbench/phpbench": "^1.7",
        "phpstan/phpstan": "^2.1"
    },
    "minimum-stability": "stable",
    "extra": {
        "branch-alias": {
            "dev-main": "2.0.x-dev",
            "dev-refactor/error-handler-v2": "2.0.x-dev"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest --testsuite Unit",
        "test:integration": "@php vendor/bin/pest --testsuite Integration",
        "phpstan": "@php vendor/bin/phpstan analyse src --level=max --no-progress",
        "benchmark": "@php vendor/bin/phpbench run --report=aggregate",
        "lint": "find src tests benchmarks -type f \\( -name '*.php' -o -name '*.phtml' \\) -exec php -l {} \\;"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "ignore-abandoned": {
                "doctrine/annotations": "Transitive PHPBench development dependency; benchmarks use attributes."
            }
        }
    },
    "prefer-stable": true
}
